{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "tests/**/*.ts",
    "exercises/**/*.ts",
    "solutions/**/*.ts",
    "skills/**/*.ts",
    "playwright.matrix.config.ts",
    "quality/**/*.ts",
    "playwright.visual.config.ts",
    "state/**/*.ts",
    "playwright.state-auth.config.ts"
  ]
}
