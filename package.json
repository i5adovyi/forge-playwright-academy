{
  "name": "forge-playwright-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original, local-first Playwright training academy with UI and API practice labs.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=ui --project=api",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:portal": "playwright test --project=portal",
    "test:solutions": "playwright test --project=solutions",
    "test:exercises": "playwright test --project=exercises",
    "test:all": "playwright test",
    "test:debug": "playwright test --project=ui --debug",
    "test:interactive": "playwright test --ui",
    "test:report": "playwright show-report",
    "check": "node --check server.mjs && node --check lab/app.js && node --check portal/app.js && node --check portal/theme.js && node --check skills/app.js && node --check state/app.js && node --check state/project-auth/run.mjs && node --check quality/accessibility/app.js && node --check quality/visual/app.js && playwright test --list && playwright test --config=playwright.visual.config.ts --list && node --check scripts/preview.mjs && node --check workplace/preflight/server.mjs && node --check workplace/recovery/server.mjs && node --check workplace/jobs/server.mjs",
    "browsers": "playwright install chromium",
    "browsers:all": "playwright install",
    "test:skills": "playwright test --project=skills",
    "test:skills:practice": "playwright test --project=skills-practice",
    "test:matrix": "playwright test --config=playwright.matrix.config.ts",
    "test:a11y": "playwright test --project=accessibility",
    "test:a11y:practice": "playwright test --project=accessibility-practice",
    "test:visual": "playwright test --config=playwright.visual.config.ts --project=visual",
    "test:visual:practice": "playwright test --config=playwright.visual.config.ts --project=visual-practice",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --project=visual --update-snapshots=all",
    "test:visual:defect": "playwright test --config=quality/visual/defect.config.ts",
    "test:state": "playwright test --project=state",
    "test:state:practice": "playwright test --project=state-practice",
    "test:state:auth": "node state/project-auth/run.mjs",
    "test:state:auth:gate": "node state/project-auth/run.mjs --prove-gate",
    "test:api:workshop": "playwright test --project=api-workshop",
    "test:api:practice": "playwright test --project=api-practice",
    "test:ui:workshop": "playwright test --project=ui-workshop",
    "test:ui:practice": "playwright test --project=ui-practice",
    "test:incidents": "node workplace/incidents/run.mjs --solutions",
    "test:incidents:broken": "node workplace/incidents/run.mjs --broken",
    "test:incidents:practice": "node workplace/incidents/run.mjs --practice",
    "test:incidents:proof": "node workplace/incidents/run.mjs --prove",
    "test:gates": "node workplace/gates/run.mjs",
    "test:gates:proof": "node workplace/gates/run.mjs --prove-gate",
    "test:gates:unit": "node --test workplace/gates/gate.test.mjs",
    "test:gates:practice": "node workplace/gates/run.mjs --practice",
    "test:refactoring": "playwright test --project=workplace-refactoring",
    "test:refactoring:practice": "playwright test --project=workplace-refactoring-practice",
    "test:refactoring:proof": "node workplace/refactoring/prove.mjs",
    "test:builders": "playwright test --project=workplace-builders",
    "test:builders:practice": "playwright test --project=workplace-builders-practice",
    "test:builders:proof": "node workplace/builders/prove.mjs",
    "test:preflight": "node workplace/preflight/run.mjs",
    "test:preflight:practice": "node workplace/preflight/run.mjs --practice",
    "test:preflight:proof": "node workplace/preflight/run.mjs --prove",
    "test:recovery": "node workplace/recovery/run.mjs --solutions",
    "test:recovery:practice": "node workplace/recovery/run.mjs --practice",
    "test:recovery:proof": "node workplace/recovery/run.mjs --proof",
    "test:jobs": "node workplace/jobs/run.mjs",
    "test:jobs:practice": "node workplace/jobs/run.mjs --practice",
    "test:jobs:proof": "node workplace/jobs/run.mjs --proof",
    "local": "node server.mjs",
    "preview": "node scripts/preview.mjs",
    "test:hosting": "playwright test --config=playwright.hosting.config.ts",
    "data:status": "node local-data/cli.mjs status",
    "data:export": "node local-data/cli.mjs export",
    "data:import": "node local-data/cli.mjs import",
    "test:data": "node --test local-data/*.test.mjs",
    "account:copy": "node scripts/new-account-copy.mjs",
    "test:portability": "node --test tests/portability/*.test.mjs",
    "test:persistence": "playwright test --config=playwright.persistence.config.ts",
    "test:beginner": "playwright test --project=beginner",
    "test:beginner:practice": "playwright test --project=beginner-practice"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
